>> A bullet: flies straight, wraps, and fades out after a moment.

life = 0.9

DEF on_step(dt) {
	self.x += self.vx * dt
	self.y += self.vy * dt
	IF self.x < 0 { self.x += 1280 }
	IF self.x > 1280 { self.x -= 1280 }
	IF self.y < 0 { self.y += 720 }
	IF self.y > 720 { self.y -= 720 }
	GLOBAL life -= dt
	IF life <= 0 { DESTROY(NULL) }
}

DEF on_collide_start(other) {
	IF GET(other, "size") !== NULL {
		SEND(other, "shot")
		DESTROY(NULL)
	}
}
