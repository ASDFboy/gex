>> The sample menu. Each Button runs on_pressed_<its name>() here.

DEF on_create() {
	SET("Title", "y", -60)
	TWEEN("Title", "y", 60, 0.8, "bounce")
}

DEF go(blueprint) {
	PLAY_SOUND("res://assets/blip.wav", 0.6)
	CHANGE_BLUEPRINT("res://blueprints/" + blueprint + ".jblueprint", 0.5)
}

DEF on_pressed_breakout() { go("breakout") }
DEF on_pressed_asteroids() { go("asteroids") }
DEF on_pressed_snake() { go("snake") }
DEF on_pressed_flappy() { go("flappy") }
DEF on_pressed_rollaball() { go("rollaball") }
DEF on_pressed_runner() { go("runner") }

DEF on_step(dt) {
	>> A slow drifting glow behind the buttons.
	SET("Glow", "x", 640 + SIN(GAME_TIME() * 20) * 260)
}
