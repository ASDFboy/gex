>> Asteroids: stars, waves of rocks, score and ships.

score = 0
ships = 3
wave = 0
stars = []

DEF on_create() {
	FOR i IN 1 TO 140 {
		>> INSERT(t, item, -1) adds a table as one item (t + table would pair them up).
		INSERT(stars, [x: RANDOM(0, 1280), y: RANDOM(0, 720), r: RANDOM(1.2, 3.0, 1)], -1)
	}
	next_wave()
	TIMER("hint", 4, FALSE)
}

DEF on_timer_hint() {
	SET("Message", "visible", FALSE)
}

DEF next_wave() {
	GLOBAL wave += 1
	FOR i IN 1 TO 2 + wave {
		>> Rocks start at the edges, away from the ship.
		side = RANDOM(1, 4)
		x = RANDOM(0, 1280)
		y = RANDOM(0, 720)
		IF side == 1 { x = 0 }
		IF side == 2 { x = 1280 }
		IF side == 3 { y = 0 }
		IF side == 4 { y = 720 }
		r = SPAWN("res://scenes/rock.jscene", x, y)
		a = RANDOM(0, 359)
		s = RANDOM(40, 90) + wave * 8
		SET(r, "vx", COS(a) * s)
		SET(r, "vy", SIN(a) * s)
	}
}

DEF on_draw() {
	t = GAME_TIME()
	FOR i, s IN stars {
		twinkle = 0.5 + 0.5 * SIN(t * 90 + i * 37)
		DRAW_CIRCLE(s.x, s.y, s.r, [r: 0.8, g: 0.85, b: 1, a: 0.35 + twinkle * 0.5], TRUE)
	}
}

DEF on_rock_destroyed(size, x, y) {
	GLOBAL score += (4 - size) * 20
	SET("Score", "text", "Score: " + score)
	SET("Boom", "x", x)
	SET("Boom", "y", y)
	BURST("Boom", size * 18)
	SHAKE(size * 2, 0.25)
	PLAY_SOUND("res://assets/boom.wav", 0.4 + size * 0.15, 1.3 - size * 0.15)
	IF LEN(NODES("rocks")) <= 1 AND size == 1 {
		TIMER("wave", 1.5, FALSE)
	}
}

DEF on_timer_wave() {
	IF LEN(NODES("rocks")) == 0 {
		next_wave()
	}
}

DEF on_ship_hit() {
	GLOBAL ships -= 1
	SET("Lives", "text", "Ships: " + ships)
	SHAKE(14, 0.6)
	PLAY_SOUND("res://assets/boom.wav", 1, 0.7)
	IF ships <= 0 {
		SET("Message", "text", "Game over - score " + score + ". Press Enter to fly again")
		SET("Message", "visible", TRUE)
		SET("Ship", "visible", FALSE)
	}
}

DEF on_press_enter() {
	IF ships <= 0 {
		CHANGE_SCENE("res://scenes/asteroids.jscene", 0.3)
	}
}
