>> The ball: moves itself, bounces off the walls, the paddle and bricks.

vx = 0
vy = 0
speed = 460
stuck = TRUE

DEF on_step(dt) {
	IF stuck {
		self.x = GET("../Paddle", "x")
		self.y = 650
		IF KEY_PRESSED("action") OR KEY_PRESSED("mouse_left") {
			GLOBAL stuck = FALSE
			GLOBAL vx = RANDOM(-220, 220)
			GLOBAL vy = 0 - speed
			EMIT("ball_launched")
		}
		RETURN
	}
	self.x += vx * dt
	self.y += vy * dt
	IF self.x < 30 {
		self.x = 30
		GLOBAL vx = ABS(vx)
	}
	IF self.x > 1250 {
		self.x = 1250
		GLOBAL vx = 0 - ABS(vx)
	}
	IF self.y < 70 {
		self.y = 70
		GLOBAL vy = ABS(vy)
	}
	IF self.y > 740 {
		GLOBAL stuck = TRUE
		GLOBAL speed = 460
		EMIT("ball_lost")
	}
}

DEF on_collide_start(other) {
	IF stuck { RETURN }
	IF NAME_OF(other) == "Paddle" {
		>> Where it lands on the paddle sets the angle.
		off = (self.x - GET(other, "x")) / 65
		GLOBAL vx = off * speed * 0.9
		GLOBAL vy = 0 - ABS(speed)
		PLAY_SOUND("res://assets/blip.wav", 0.5, 0.8)
		RETURN
	}
	points = GET(other, "points")
	IF points !== NULL {
		>> Which side did we hit? Compare the overlap across and down.
		dx = (self.x - GET(other, "x")) / 36
		dy = (self.y - GET(other, "y")) / 13
		IF ABS(dx) > ABS(dy) {
			GLOBAL vx = sign(dx) * ABS(vx)
		} ELSE {
			GLOBAL vy = sign(dy) * ABS(vy)
		}
		GLOBAL speed = MIN(speed + 6, 800)
		SET("../Sparks", "x", GET(other, "x"))
		SET("../Sparks", "y", GET(other, "y"))
		SET("../Sparks", "color", GET(other, "color"))
		BURST("../Sparks", 24)
		PLAY_SOUND("res://assets/blip.wav", 0.5, 1.2 + RANDOM(0, 4) / 10)
		DESTROY(other)
		EMIT("brick_broken", points)
	}
}

DEF sign(n) {
	IF n < 0 { RETURN -1 }
	RETURN 1
}
