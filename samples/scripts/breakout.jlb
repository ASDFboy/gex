>> Breakout: builds the wall of bricks, moves the paddle, keeps score and lives.

score = 0
lives = 3
colors = ["#ff5a5a", "#ff9d3c", "#ffd93c", "#6be36b", "#4cc3ff", "#a87bff"]

DEF on_create() {
	build_wall()
}

DEF build_wall() {
	FOR row IN 1 TO 6 {
		FOR col IN 1 TO 14 {
			b = SPAWN("res://scenes/brick.jscene", 107 + (col - 1) * 82, 110 + (row - 1) * 32)
			SET(b, "color", colors[row])
			>> Higher rows are worth more.
			SET(b, "points", (7 - row) * 10)
		}
	}
}

DEF on_step(dt) {
	>> The paddle follows the mouse, or the arrow keys.
	px = GET("Paddle", "x")
	IF KEY_DOWN("left") { px -= 700 * dt }
	IF KEY_DOWN("right") { px += 700 * dt }
	IF ABS(MOUSE_X() - last_mouse) > 0.5 { px = MOUSE_X() }
	GLOBAL last_mouse = MOUSE_X()
	>> P turns on the autopilot: the paddle chases the ball (a demo mode).
	IF autopilot { px = GET("Ball", "x") + SIN(GAME_TIME() * 70) * 40 }
	SET("Paddle", "x", MAX(85, MIN(1195, px)))
}
last_mouse = 0
autopilot = FALSE

DEF on_press_p() {
	GLOBAL autopilot = !autopilot
}

DEF on_brick_broken(points) {
	GLOBAL score += points
	SET("Score", "text", "Score: " + score)
	IF LEN(NODES("bricks")) <= 1 {
		SET("Message", "text", "Wall cleared! Here comes another...")
		SET("Message", "visible", TRUE)
		TIMER("rebuild", 1.5, FALSE)
	}
}

DEF on_timer_rebuild() {
	build_wall()
	SET("Message", "visible", FALSE)
}

DEF on_ball_lost() {
	GLOBAL lives -= 1
	SET("Lives", "text", "Lives: " + lives)
	SHAKE(10, 0.4)
	PLAY_SOUND("res://assets/hit.wav")
	IF lives <= 0 {
		SET("Message", "text", "Game over! Score " + score + ". Space to play again")
		GLOBAL lives = 3
		GLOBAL score = 0
		SET("Score", "text", "Score: 0")
		SET("Lives", "text", "Lives: 3")
		FOR b IN NODES("bricks") { DESTROY(b) }
		TIMER("rebuild", 0.1, FALSE)
	} ELSE {
		SET("Message", "text", "Space or click to launch  (P: autopilot)")
	}
	SET("Message", "visible", TRUE)
}

DEF on_ball_launched() {
	SET("Message", "visible", FALSE)
}
