>> The ship: turn, thrust (with a little drag), shoot, wrap around the screen.

vx = 0
vy = 0
cooldown = 0
safe = 2

DEF on_step(dt) {
	IF !self.visible { RETURN }
	IF KEY_DOWN("left") { self.rotation -= 240 * dt }
	IF KEY_DOWN("right") { self.rotation += 240 * dt }
	thrust = KEY_DOWN("up")
	SET("Flame", "emitting", thrust)
	IF thrust {
		>> The picture points up, so "forward" is rotation - 90 degrees.
		GLOBAL vx += COS(self.rotation - 90) * 420 * dt
		GLOBAL vy += SIN(self.rotation - 90) * 420 * dt
	}
	GLOBAL vx = vx * (1 - 0.6 * dt)
	GLOBAL vy = vy * (1 - 0.6 * dt)
	self.x = wrap(self.x + vx * dt, 1280)
	self.y = wrap(self.y + vy * dt, 720)
	GLOBAL cooldown -= dt
	IF KEY_DOWN("action") AND cooldown <= 0 {
		GLOBAL cooldown = 0.18
		a = self.rotation - 90
		b = SPAWN("res://blueprints/bullet.jblueprint", self.x + COS(a) * 24, self.y + SIN(a) * 24)
		SET(b, "vx", COS(a) * 700 + vx)
		SET(b, "vy", SIN(a) * 700 + vy)
		PLAY_SOUND("res://assets/laser.wav", 0.35)
	}
	>> Blink while safe after a respawn.
	IF safe > 0 {
		GLOBAL safe -= dt
		self.color = [r: 1, g: 1, b: 1, a: 0.4 + 0.6 * ROUND(GAME_TIME() * 8 % 1)]
	} ELSE {
		self.color = [r: 1, g: 1, b: 1, a: 1]
	}
}

DEF wrap(v, size) {
	IF v < 0 { RETURN v + size }
	IF v > size { RETURN v - size }
	RETURN v
}

DEF on_collide_start(other) {
	IF safe > 0 OR !self.visible { RETURN }
	IF GET(other, "size") !== NULL {
		EMIT("ship_hit")
		self.x = 640
		self.y = 360
		GLOBAL vx = 0
		GLOBAL vy = 0
		GLOBAL safe = 2.5
	}
}
