>> The neon runner: blocks rush at the player, faster and faster.

speed = 14
dist = 0
over = FALSE

DEF on_create() {
	TIMER("spawn", 0.9, TRUE)
	TIMER("scenery", 0.35, TRUE)
	TIMER("hint", 3, FALSE)
}

DEF on_timer_hint() {
	IF !over { SET("Message", "visible", FALSE) }
}

DEF on_timer_spawn() {
	IF over { RETURN }
	>> One or two of the three lanes get a block.
	lane = RANDOM(-1, 1)
	SPAWN("res://blueprints/block.jblueprint", lane * 2.2, 0.6, -70)
	IF RANDOM(1, 3) == 1 {
		other = lane + 1
		IF other > 1 { other = -1 }
		SPAWN("res://blueprints/block.jblueprint", other * 2.2, 0.6, -70)
	}
}

DEF on_timer_scenery() {
	IF over { RETURN }
	SPAWN("res://blueprints/pillar.jblueprint", -6, 3, -70)
	SPAWN("res://blueprints/pillar.jblueprint", 6, 3, -70)
}

DEF on_step(dt) {
	IF over { RETURN }
	GLOBAL speed += 0.25 * dt
	GLOBAL dist += speed * dt
	self.speed = speed
	SET("Score", "text", ROUND(dist) + " m")
	px = GET("Player", "x")
	py = GET("Player", "y")
	FOR b IN OBJECTS("blocks") {
		z = GET(b, "z") + speed * dt
		SET(b, "z", z)
		IF z > 8 {
			DESTROY(b)
		} ELIF ABS(z) < 0.9 AND ABS(GET(b, "x") - px) < 1.1 AND py < 1.3 {
			crash()
		}
	}
	FOR p IN OBJECTS("scenery") {
		z = GET(p, "z") + speed * dt
		SET(p, "z", z)
		IF z > 8 { DESTROY(p) }
	}
}

DEF crash() {
	GLOBAL over = TRUE
	self.over = TRUE
	SET("Crash", "x", GET("Player", "x"))
	SET("Crash", "y", GET("Player", "y"))
	SET("Crash", "z", 0)
	BURST("Crash", 80)
	SET("Player", "visible", FALSE)
	SHAKE(16, 0.6)
	PLAY_SOUND("res://assets/boom.wav")
	best = LOAD_DATA("runner_best")
	IF best == NULL OR dist > best {
		best = dist
		SAVE_DATA("runner_best", dist)
	}
	SET("Message", "text", ROUND(dist) + " m  (best " + ROUND(best) + " m)" + '\nEnter to run again')
	SET("Message", "visible", TRUE)
}

DEF on_press_enter() {
	IF over { CHANGE_BLUEPRINT("res://blueprints/runner.jblueprint", 0.3) }
}
