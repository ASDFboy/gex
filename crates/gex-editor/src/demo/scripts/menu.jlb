>> The menu: each Button runs on_pressed_<its name>() on every script that has it.
>> CHANGE_SCENE's second input fades out and back in over that many seconds.

DEF on_create() {
	>> The title drops in and bounces (TWEEN slides any number or color).
	SET("Title", "y", 40)
	TWEEN("Title", "y", 170, 0.9, "bounce")
	best = LOAD_DATA("best")
	IF best !== NULL {
		SET("Best", "text", "Best coin score: " + best)
	}
}

DEF on_pressed_coins() {
	CHANGE_SCENE("res://scenes/main.jscene", 0.6)
}

DEF on_pressed_platformer() {
	CHANGE_SCENE("res://scenes/platformer.jscene", 0.6)
}

DEF on_pressed_world() {
	CHANGE_SCENE("res://scenes/world3d.jscene", 0.6)
}

DEF on_pressed_fps() {
	CHANGE_SCENE("res://scenes/fps.jscene", 0.6)
}
