>> A platformer character: a kinematic Body2D moved with MOVE, which slides along
>> walls and floors and gives back TRUE when we end up standing on something.

speed = 260
gravity = 1400
jump = 560
vy = 0
on_floor = FALSE

DEF on_physics(dt) {
	>> move_left, move_right and jump are input actions (Project settings), so each
	>> covers the arrows, WASD and a gamepad at once.
	dx = AXIS("left_x")
	IF KEY_DOWN("move_left") { dx = -1 }
	IF KEY_DOWN("move_right") { dx = 1 }
	IF KEY_PRESSED("jump") AND on_floor {
		GLOBAL vy = 0 - jump
		PLAY_SOUND("res://assets/jump.wav")
	}
	GLOBAL vy = MIN(vy + gravity * dt, 900)
	GLOBAL on_floor = MOVE(NULL, dx * speed * dt, vy * dt)
	IF on_floor AND vy > 0 {
		>> A hard landing shakes the camera a little.
		IF vy > 800 { SHAKE(6, 0.3) }
		GLOBAL vy = 0
	}
	>> Bumping a ceiling ends the jump early.
	above = RAYCAST(self.x, self.y - 23, 0, -1, 3, self.id)
	IF above !== NULL AND vy < 0 { GLOBAL vy = 0 }
	>> Fell off the world: back to the start.
	IF self.y > 760 {
		SHAKE(12, 0.5)
		self.x = 120
		self.y = 560
		GLOBAL vy = 0
	}
}

DEF on_collide_start(other) {
	>> Run into the crate or the ball: knock it upward.
	IF NAME_OF(other) == "Crate" OR NAME_OF(other) == "Ball" {
		IMPULSE(other, 0, -250)
	}
}
