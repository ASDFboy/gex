>> The player: a kinematic capsule (Body3D) moved with MOVE, with the camera behind it.
>> x is right and z is backwards (forward is -z).

speed = 6
gravity = 20
jump = 7
vy = 0
on_floor = FALSE

DEF on_physics(dt) {
	>> The move_ and jump actions are in File > Project settings > Input.
	fx = AXIS("left_x")
	fz = AXIS("left_y")
	IF KEY_DOWN("move_left") { fx = -1 }
	IF KEY_DOWN("move_right") { fx = 1 }
	IF KEY_DOWN("move_forward") { fz = -1 }
	IF KEY_DOWN("move_back") { fz = 1 }
	IF KEY_PRESSED("jump") AND on_floor {
		GLOBAL vy = jump
	}
	GLOBAL vy -= gravity * dt
	GLOBAL on_floor = MOVE(NULL, fx * speed * dt, vy * dt, fz * speed * dt)
	IF on_floor AND vy < 0 { GLOBAL vy = 0 }
	>> Fell off the world: back to the start.
	IF self.y < -20 {
		self.x = 0
		self.y = 1
		self.z = 4
		GLOBAL vy = 0
	}
}
